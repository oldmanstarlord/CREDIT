# Barclays Credit Intelligence Platform - Environment Configuration
# Copy this to .env and fill in actual values

# ─── APPLICATION ───────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=False

# ─── DATABASE ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://admin:postgres@localhost:5432/barclays_credit
SQLALCHEMY_ECHO=False

# ─── REDIS ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_CACHE_EXPIRY=3600

# ─── SECURITY ──────────────────────────────────────────────────────────────
JWT_SECRET=super-secret-key-change-in-production-immediately
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AWS ────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
S3_BUCKET_NAME=barclays-credit-platform
S3_LOGS_BUCKET=barclays-credit-platform-logs

# ─── LLM / GENAI (OpenRouter-first, fallback to OpenAI) ───────────────────
LLM_PROVIDER=openrouter

# OpenRouter (recommended free-tier path)
OPENROUTER_API_KEY=or-your-key-here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_FALLBACK_MODELS=openai/gpt-oss-20b:free,google/gemma-3n-e4b-it:free,qwen/qwen3-4b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Barclays Credit Intelligence Platform

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=500

# ─── ML MODEL ──────────────────────────────────────────────────────────────
ML_MODEL_VERSION=v1.0.0
DECISION_THRESHOLD=0.35
AUTO_REJECT_PD_THRESHOLD=0.65
AUTO_APPROVE_PD_THRESHOLD=0.15
MIN_CREDIT_SCORE_FOR_APPROVAL=500
# Optional hard pin for exact notebook winner serving artifact
WINNER_MODEL_PATH=ml_pipeline/models/integration_contracts/winner_upgrade_v4/winner_v4_serving_artifact.pkl

# ─── BUSINESS RULES ────────────────────────────────────────────────────────
EMI_TO_INCOME_MAX_RATIO=0.40
FARMER_EMI_TO_INCOME_MAX=0.30
DAILY_WORKER_EMI_TO_INCOME_MAX=0.25
MAX_LOAN_WITHOUT_COLLATERAL=100000
MAX_EXPOSURE_PER_USER=1000000
NEW_USER_MAX_LOAN=50000

# ─── FRAUD DETECTION ───────────────────────────────────────────────────────
FRAUD_SCORE_HOLD_THRESHOLD=0.3
FRAUD_SCORE_REJECT_THRESHOLD=0.6

# ─── FEATURE FLAGS ─────────────────────────────────────────────────────────
ENABLE_S3_UPLOAD=True
ENABLE_GENAI_EXPLANATIONS=True
ENABLE_FAIRNESS_MONITORING=True
SIMULATE_MODE=False

# ─── EMAIL CONFIGURATION ──────────────────────────────────────────────────
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@barclays-credit.com
SMTP_PASSWORD=your_email_password_here
EMAIL_FROM=noreply@barclays-credit.com

# ─── LOGGING ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── FRONTEND (React) ──────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000
REACT_APP_ENV=development

# ─── DATABASE PASSWORD (Docker Compose) ────────────────────────────────────
DB_PASSWORD=postgres

# ─── DATASET PATHS (workspace-level) ───────────────────────────────────────
# Canonical location after workspace cleanup: ../datasets
DATASETS_ROOT=../datasets
DATASETS_RAW_DIR=../datasets/raw
DATASETS_ARCHIVES_DIR=../datasets/archives

# Primary training/inference datasets
MYTRANSACTION_CSV=../datasets/raw/my-transaction/MyTransaction.csv
PAYSIM_FRAUD_CSV=../datasets/raw/paysim-fraud/PS_20174392719_1491204439457_log.csv
GMSC_TRAIN_CSV=../datasets/raw/give-me-some-credit/cs-training.csv
GMSC_TEST_CSV=../datasets/raw/give-me-some-credit/cs-test.csv
GMSC_SAMPLE_SUBMISSION_CSV=../datasets/raw/give-me-some-credit/sampleEntry.csv
HOME_CREDIT_TRAIN_CSV=../datasets/raw/home-credit/application_train.csv
HOME_CREDIT_TEST_CSV=../datasets/raw/home-credit/application_test.csv
HOME_CREDIT_COLUMNS_DESCRIPTION_CSV=../datasets/raw/home-credit/HomeCredit_columns_description.csv
LENDING_CLUB_LOAN_CSV=../datasets/raw/lending-club/loan.csv
LENDING_CLUB_DICTIONARY_XLSX=../datasets/raw/lending-club/LCDataDictionary.xlsx

# Email/SMTP Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@barclays-credit.com
